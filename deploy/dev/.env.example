# Express server port
PORT=8004

# Node environment
NODE_ENV=production

# Clerk authentication (server-side secret — use test-mode keys for dev)
CLERK_SECRET_KEY=sk_test_...

# Clerk publishable key (baked into frontend build, also used by Express server — use test-mode keys for dev)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk proxy URL (baked into frontend build)
VITE_CLERK_PROXY_URL=https://dev-link.expertintheloop.io/api/__clerk

# Biomapper2 API connection
BIOMAPPER_API_KEY=your-api-key-here
BIOMAPPER_BASE_URL=http://localhost:8003/api/v1
BIOMAPPER_DEV_BASE_URL=http://localhost:8003/api/v1

# Python API port
PYTHON_API_PORT=8005

