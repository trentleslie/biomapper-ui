[Unit]
Description=Biomapper UI Dev Express API Server
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=$DEPLOY_DIR/artifacts/api-server

# Environment variables
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment=PORT=8004
Environment=NODE_ENV=production
EnvironmentFile=$DEPLOY_DIR/.env

ExecStart=/usr/bin/node --enable-source-maps $DEPLOY_DIR/artifacts/api-server/dist/index.mjs

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=biomapper-ui-dev-express

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=$DEPLOY_DIR

[Install]
WantedBy=multi-user.target
